{
  "expo": {
    "name": "نُور - Nour",
    "slug": "nour",
    "version": "1.5.1",
    "scheme": "nour",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nour.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة بدقة."
      }
    },
    "android": {
      "package": "com.nour.app",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#F8F9FA"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-firebase/app",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A24B",
          "defaultChannel": "nour-reminders-v1-5",
          "sounds": [
            "./assets/sounds/adhan.wav",
            "./assets/sounds/azkar_sobh.wav",
            "./assets/sounds/azkar_masaa.wav",
            "./assets/sounds/reminder.wav"
          ]
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-media-library",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج نور إلى اختيار صورة لاستخدامها كصورة شخصية للحساب."
        }
      ],
      "expo-web-browser",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "30f86dc9-c6dc-4e68-9033-a333aaec643a"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}